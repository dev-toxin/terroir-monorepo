# Terroir local development environment
# Copy this file to .env and put real local secrets there.

# Public domains
APP_PUBLIC_URL=https://terroir-app.com
API_PUBLIC_URL=https://api.terroir-app.com

# PostgreSQL
POSTGRES_DB=terroir
POSTGRES_USER=terroir_app
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://terroir_app:change_me_local_password@localhost:5432/terroir?sslmode=disable

# Backend
BACKEND_HTTP_ADDR=:8080
APP_ENV=local

# AI / OCR providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
YANDEX_VISION_API_KEY=
GOOGLE_VISION_API_KEY=

# Storage
LOCAL_STORAGE_PATH=.tmp/storage
