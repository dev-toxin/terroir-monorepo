# Terroir — environment template. Copy to .env for local overrides (never commit .env).
# `make dev` works WITHOUT any of this: SQLite + demo data + mock LLM.

# --- App ---
APP_ENV=local
BACKEND_HTTP_ADDR=:8080
# Fix "today" for demos/tests (drinking windows depend on the current year). Empty = real date.
TERROIR_TODAY=

# --- Storage: sqlite | postgres | memory ---
STORAGE=sqlite
SQLITE_PATH=tmp/terroir-dev.db
# Seed demo household (Anton, Elena) on start if it does not exist.
AUTO_SEED=true

# PostgreSQL (used when STORAGE=postgres; docker compose reads POSTGRES_*)
POSTGRES_DB=terroir
POSTGRES_USER=terroir_app
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432
DATABASE_URL=

# --- Auth (MVP): static bearer tokens, "user_id:token,user_id:token" (token >= 8 chars) ---
# Demo seed already creates dev-anton-token / dev-elena-token.
AUTH_TOKENS=

# --- LLM: exactly one OpenAI-compatible provider. Default: mock (deterministic, no network). ---
LLM_PROVIDER=mock
# Example for Yandex AI Studio (keys are NOT in the repo):
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   LLM_MODEL=gpt://<FOLDER_ID>/yandexgpt/latest
#   LLM_AUTH_SCHEME=Api-Key
#   LLM_EXTRA_HEADERS=x-data-logging-enabled:false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Bearer | Api-Key
LLM_AUTH_SCHEME=Bearer
# Comma-separated name:value, whitelist: x-data-logging-enabled, x-folder-id, openai-project, openai-organization
LLM_EXTRA_HEADERS=
# Optional; not sent when empty
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=800
LLM_TIMEOUT=30s
LLM_MAX_RETRIES=2
LLM_CONTEXT_TOKENS=3000
# Monthly limits for the whole install; 0 = unlimited. Budget is in your billing currency.
LLM_MONTHLY_BUDGET=0
LLM_MONTHLY_TOKENS=0
LLM_PRICE_PER_1K_INPUT=0
LLM_PRICE_PER_1K_OUTPUT=0
